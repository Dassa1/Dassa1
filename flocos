<svg width="1200" height="350" viewBox="0 0 1200 350"
     xmlns="http://www.w3.org/2000/svg">

  <defs>

    <!-- Fundo -->
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071a2b"/>
      <stop offset="35%" stop-color="#173f61"/>
      <stop offset="70%" stop-color="#28749f"/>
      <stop offset="100%" stop-color="#bdeeff"/>
    </linearGradient>

    <!-- Brilho central -->
    <radialGradient id="light" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#dff8ff" stop-opacity=".35"/>
      <stop offset="50%" stop-color="#7ddcff" stop-opacity=".12"/>
      <stop offset="100%" stop-color="#071a2b" stop-opacity="0"/>
    </radialGradient>

    <!-- Brilho do texto -->
    <filter id="textGlow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

  </defs>

  <!-- Fundo -->
  <rect width="1200"
        height="350"
        rx="20"
        fill="url(#bg)"/>

  <!-- Luz -->
  <rect width="1200"
        height="350"
        rx="20"
        fill="url(#light)"/>

  <!-- Neve -->
  <g fill="white">

    <circle cx="80" cy="55" r="3" opacity=".75"/>
    <circle cx="145" cy="180" r="2" opacity=".55"/>
    <circle cx="220" cy="80" r="2" opacity=".8"/>
    <circle cx="285" cy="240" r="3" opacity=".6"/>
    <circle cx="350" cy="55" r="1.5" opacity=".7"/>
    <circle cx="410" cy="290" r="2" opacity=".8"/>
    <circle cx="480" cy="110" r="2" opacity=".5"/>
    <circle cx="535" cy="45" r="3" opacity=".7"/>

    <circle cx="665" cy="60" r="2" opacity=".7"/>
    <circle cx="720" cy="270" r="3" opacity=".55"/>
    <circle cx="780" cy="115" r="1.5" opacity=".8"/>
    <circle cx="835" cy="300" r="2" opacity=".65"/>
    <circle cx="900" cy="55" r="3" opacity=".75"/>
    <circle cx="965" cy="150" r="2" opacity=".6"/>
    <circle cx="1030" cy="85" r="1.5" opacity=".8"/>
    <circle cx="1100" cy="250" r="3" opacity=".65"/>
    <circle cx="1150" cy="120" r="2" opacity=".7"/>

  </g>

  <!-- Flocos decorativos -->
  <g fill="#ffffff"
     font-family="Georgia, serif"
     text-anchor="middle">

    <text x="160" y="115"
          font-size="38"
          opacity=".65">
      ❄
    </text>

    <text x="1030" y="235"
          font-size="45"
          opacity=".55">
      ❄
    </text>

    <text x="310" y="300"
          font-size="28"
          opacity=".45">
      ❄
    </text>

    <text x="900" y="85"
          font-size="30"
          opacity=".5">
      ❄
    </text>

  </g>

  <!-- Conteúdo -->
  <g text-anchor="middle"
     fill="white"
     font-family="Georgia, serif">

    <!-- Welcome -->
    <text x="600"
          y="105"
          font-size="14"
          letter-spacing="7"
          opacity=".9">
      WELCOME
    </text>

    <!-- Nome -->
    <text x="600"
          y="175"
          font-size="70"
          font-weight="normal"
          letter-spacing="12"
          filter="url(#textGlow)">
      HADASSA
    </text>

    <!-- Linha -->
    <rect x="540"
          y="202"
          width="120"
          height="2"
          rx="1"
          fill="#dff8ff"/>

    <!-- Cargo -->
    <text x="600"
          y="245"
          font-size="25"
          letter-spacing="8"
          fill="#e9faff">
      DEVELOPER
    </text>

    <!-- Tecnologias -->
    <text x="600"
          y="277"
          font-family="Arial, sans-serif"
          font-size="12"
          letter-spacing="4"
          fill="#e9faff"
          opacity=".85">
      JAVA • C • HTML • CSS
    </text>

  </g>

  <!-- Borda -->
  <rect x="1"
        y="1"
        width="1198"
        height="348"
        rx="20"
        fill="none"
        stroke="#9ce8ff"
        stroke-opacity=".45"
        stroke-width="2"/>

</svg>
